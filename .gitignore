```gitignore
# =========================
# Rust / Cargo
# =========================
/target/
**/*.rs.bk
Cargo.lock

# =========================
# Leptos / cargo-leptos
# =========================
/site/
/pkg/
/dist/
/style/output/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# macOS
# =========================
.DS_Store
.AppleDouble
.LSOverride
._*

# =========================
# VS Code
# =========================
.vscode/

# =========================
# JetBrains IDEs
# =========================
.idea/

# =========================
# Vim / Neovim
# =========================
*.swp
*.swo
*~

# =========================
# Node.js (if using Tailwind CSS)
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Temporary files
# =========================
*.tmp
*.bak
.cache/
.tmp/
```
